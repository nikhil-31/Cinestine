<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/background"
  android:orientation="vertical">

  <LinearLayout
    android:id="@+id/media_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="@dimen/grid_padding"
    android:visibility="gone">

    <com.google.android.material.chip.ChipGroup
      android:id="@+id/category_toggle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:paddingHorizontal="@dimen/grid_padding"
      android:paddingTop="8dp"
      android:paddingBottom="4dp"
      app:chipSpacingHorizontal="8dp"
      app:selectionRequired="true"
      app:singleSelection="true">

      <com.google.android.material.chip.Chip
        android:id="@+id/chip_movies"
        style="@style/Widget.Cinestine.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/chip_movies" />

      <com.google.android.material.chip.Chip
        android:id="@+id/chip_tv"
        style="@style/Widget.Cinestine.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chip_tv" />

      <com.google.android.material.chip.Chip
        android:id="@+id/chip_people"
        style="@style/Widget.Cinestine.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chip_people"
        android:visibility="gone" />

      <com.google.android.material.chip.Chip
        android:id="@+id/chip_collections"
        style="@style/Widget.Cinestine.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chip_collections"
        android:visibility="gone" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.chip.Chip
      android:id="@+id/chip_filter"
      style="@style/Widget.Cinestine.Chip.Filter"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:checkable="true"
      android:text="@string/action_filter"
      android:visibility="gone"
      app:chipIcon="@drawable/ic_filter"
      app:chipIconVisible="true"
      app:checkedIconVisible="false" />
  </LinearLayout>

  <HorizontalScrollView
    android:id="@+id/catalog_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none"
    android:visibility="gone">

    <com.google.android.material.chip.ChipGroup
      android:id="@+id/catalog_toggle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:paddingHorizontal="@dimen/grid_padding"
      android:paddingBottom="4dp"
      app:chipSpacingHorizontal="8dp"
      app:selectionRequired="true"
      app:singleSelection="true">

      <com.google.android.material.chip.Chip
        android:id="@+id/chip_catalog_popular"
        style="@style/Widget.Cinestine.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/chip_popular" />

      <com.google.android.material.chip.Chip
        android:id="@+id/chip_catalog_trending"
        style="@style/Widget.Cinestine.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chip_trending" />

      <com.google.android.material.chip.Chip
        android:id="@+id/chip_catalog_now"
        style="@style/Widget.Cinestine.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chip_now_playing" />

      <com.google.android.material.chip.Chip
        android:id="@+id/chip_catalog_upcoming"
        style="@style/Widget.Cinestine.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chip_upcoming" />
    </com.google.android.material.chip.ChipGroup>
  </HorizontalScrollView>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/recycler_movies"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:clipToPadding="false"
      android:overScrollMode="never"
      android:paddingHorizontal="@dimen/grid_padding"
      android:paddingTop="8dp"
      android:paddingBottom="24dp" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
      android:id="@+id/progress"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:indeterminate="true"
      android:visibility="gone"
      app:indicatorColor="@color/colorPrimary" />

    <LinearLayout
      android:id="@+id/error_state"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:gravity="center"
      android:orientation="vertical"
      android:padding="32dp"
      android:visibility="gone">

      <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_error_outline" />

      <TextView
        android:id="@+id/error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="@color/on_surface_variant" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/empty_state"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:gravity="center"
      android:orientation="vertical"
      android:padding="32dp"
      android:visibility="gone">

      <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_empty_movies" />

      <TextView
        android:id="@+id/empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="@color/on_surface" />

      <TextView
        android:id="@+id/empty_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/empty_favourites_hint"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/on_surface_variant" />
    </LinearLayout>
  </FrameLayout>
</LinearLayout>
