<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/main_content"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/background"
  android:fitsSystemWindows="true"
  tools:context=".ui.details.DetailsFragment">

  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/appbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    app:elevation="0dp">

    <com.google.android.material.appbar.CollapsingToolbarLayout
      android:id="@+id/collapsing_toolbar"
      android:layout_width="match_parent"
      android:layout_height="@dimen/detail_backdrop_height"
      android:fitsSystemWindows="true"
      app:collapsedTitleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
      app:collapsedTitleTextColor="@color/white"
      app:contentScrim="@color/scrim_toolbar"
      app:expandedTitleTextColor="@android:color/transparent"
      app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
      app:statusBarScrim="@color/scrim_toolbar">

      <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/content_desc_poster"
        android:fitsSystemWindows="true"
        android:scaleType="centerCrop"
        app:layout_collapseMode="parallax"
        app:layout_collapseParallaxMultiplier="0.25"
        tools:src="@drawable/ic_poster_placeholder" />

      <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/details_hero_top_scrim"
        app:layout_collapseMode="pin" />

      <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:layout_collapseMode="pin"
        app:navigationIconTint="@color/white"
        app:popupTheme="@style/Theme.Cinestine.PopupOverlay"
        app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.CollapsingToolbarLayout>
  </com.google.android.material.appbar.AppBarLayout>

  <androidx.core.widget.NestedScrollView
    android:id="@+id/details_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/background"
      android:orientation="vertical"
      android:paddingTop="16dp"
      android:paddingBottom="40dp">

      <TextView
        android:id="@+id/title_write"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:paddingHorizontal="20dp"
        android:text="@string/Select"
        android:textAppearance="@style/TextAppearance.Cinestine.DetailsTitle"
        tools:text="The Grand Budapest Hotel" />

      <TextView
        android:id="@+id/tagline_write"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="6dp"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/on_surface_variant"
        android:visibility="gone"
        tools:text="A long time ago in a galaxy far, far away..."
        tools:visibility="visible" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/play_trailer"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/colorPrimary"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="16dp"
        android:text="@string/watch_trailer"
        android:textColor="@color/colorOnPrimary"
        android:visibility="gone"
        app:cornerRadius="100dp"
        app:icon="@drawable/ic_play"
        app:iconPadding="8dp"
        app:iconSize="16dp"
        app:iconTint="@color/colorOnPrimary"
        tools:visibility="visible" />

      <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/meta_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <com.google.android.material.card.MaterialCardView
          android:id="@+id/poster_card"
          android:layout_width="@dimen/detail_poster_width"
          android:layout_height="@dimen/detail_poster_height"
          app:cardCornerRadius="14dp"
          app:cardElevation="4dp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:strokeWidth="0dp">

          <ImageView
            android:id="@+id/poster_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/content_desc_poster"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_poster_placeholder" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
          android:id="@+id/release_write"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_meta_pill"
          android:paddingHorizontal="12dp"
          android:paddingVertical="6dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:textColor="@color/on_surface"
          tools:text="2014" />

        <TextView
          android:id="@+id/meta_language"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_meta_pill"
          android:paddingHorizontal="12dp"
          android:paddingVertical="6dp"
          android:textAllCaps="true"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:textColor="@color/on_surface"
          tools:text="EN" />

        <TextView
          android:id="@+id/meta_votes"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_meta_pill"
          android:paddingHorizontal="12dp"
          android:paddingVertical="6dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:textColor="@color/on_surface"
          tools:text="12.4K" />

        <TextView
          android:id="@+id/meta_runtime"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_meta_pill"
          android:paddingHorizontal="12dp"
          android:paddingVertical="6dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:textColor="@color/on_surface"
          android:visibility="gone"
          tools:text="2h 1m"
          tools:visibility="visible" />

        <TextView
          android:id="@+id/meta_seasons"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_meta_pill"
          android:paddingHorizontal="12dp"
          android:paddingVertical="6dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:textColor="@color/on_surface"
          android:visibility="gone"
          tools:text="8 seasons"
          tools:visibility="visible" />

        <TextView
          android:id="@+id/meta_episodes"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_meta_pill"
          android:paddingHorizontal="12dp"
          android:paddingVertical="6dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:textColor="@color/on_surface"
          android:visibility="gone"
          tools:text="73 episodes"
          tools:visibility="visible" />

        <TextView
          android:id="@+id/meta_certification"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_meta_pill"
          android:paddingHorizontal="12dp"
          android:paddingVertical="6dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:textColor="@color/on_surface"
          android:visibility="gone"
          tools:text="PG-13"
          tools:visibility="visible" />

        <androidx.constraintlayout.helper.widget.Flow
          android:id="@+id/meta_pills"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="16dp"
          android:layout_marginEnd="12dp"
          app:constraint_referenced_ids="release_write,meta_language,meta_votes,meta_runtime,meta_certification,meta_seasons,meta_episodes"
          app:flow_horizontalBias="0"
          app:flow_horizontalGap="8dp"
          app:flow_horizontalStyle="packed"
          app:flow_verticalGap="8dp"
          app:flow_wrapMode="chain"
          app:layout_constraintEnd_toStartOf="@id/score_cluster"
          app:layout_constraintStart_toEndOf="@id/poster_card"
          app:layout_constraintTop_toTopOf="parent" />

        <TextView
          android:id="@+id/release_label"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="16dp"
          android:layout_marginTop="4dp"
          android:text="@string/releaseDate"
          android:textAppearance="@style/TextAppearance.Material3.BodySmall"
          android:textColor="@color/on_surface_variant"
          android:visibility="gone"
          app:layout_constraintEnd_toStartOf="@id/score_cluster"
          app:layout_constraintStart_toEndOf="@id/poster_card"
          app:layout_constraintTop_toBottomOf="@id/meta_pills" />

        <LinearLayout
          android:id="@+id/score_cluster"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:orientation="vertical"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent">

          <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
              android:id="@+id/rating_ring"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="center"
              android:max="100"
              android:progress="80"
              app:indicatorColor="@color/gold"
              app:indicatorSize="68dp"
              app:trackColor="@color/outline"
              app:trackCornerRadius="100dp"
              app:trackThickness="5dp" />

            <TextView
              android:id="@+id/rating_write"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="center"
              android:textAppearance="@style/TextAppearance.Cinestine.Score"
              tools:text="8.1" />
          </FrameLayout>

          <TextView
            android:id="@+id/rating_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/Rating"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="@color/on_surface_variant" />
        </LinearLayout>
      </androidx.constraintlayout.widget.ConstraintLayout>

      <com.google.android.material.chip.ChipGroup
        android:id="@+id/genre_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:visibility="gone"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp" />

      <TextView
        android:id="@+id/networks_write"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/on_surface_variant"
        android:visibility="gone"
        tools:text="On HBO"
        tools:visibility="visible" />

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/next_episode_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_container"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:rippleColor="@color/ripple"
        app:strokeWidth="0dp"
        tools:visibility="visible">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

          <TextView
            android:id="@+id/next_episode_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/next_episode"
            android:textAppearance="@style/TextAppearance.Cinestine.Section" />

          <TextView
            android:id="@+id/next_episode_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="@color/on_surface"
            tools:text="S9 E1  ·  The Long Night" />

          <TextView
            android:id="@+id/next_episode_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/on_surface_variant"
            tools:text="2026-04-12" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <LinearLayout
        android:id="@+id/overview_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/overview"
          android:textAppearance="@style/TextAppearance.Cinestine.Section" />

        <TextView
          android:id="@+id/overview_new"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:lineSpacingExtra="6dp"
          android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
          android:textColor="@color/on_surface"
          tools:text="A legendary concierge and his lobby boy become wrapped up in a murder mystery at a famous European hotel." />

        <TextView
          android:id="@+id/overview_toggle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:paddingVertical="4dp"
          android:text="@string/show_more"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:textColor="@color/colorPrimary"
          android:visibility="gone"
          tools:visibility="visible" />
      </LinearLayout>

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/collection_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_container"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:rippleColor="@color/ripple"
        app:strokeWidth="0dp"
        tools:visibility="visible">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:padding="12dp">

          <com.google.android.material.card.MaterialCardView
            android:layout_width="56dp"
            android:layout_height="84dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
              android:id="@+id/collection_poster"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:contentDescription="@string/collection"
              android:scaleType="centerCrop"
              tools:src="@drawable/ic_poster_placeholder" />
          </com.google.android.material.card.MaterialCardView>

          <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/collection"
              android:textAppearance="@style/TextAppearance.Cinestine.Section" />

            <TextView
              android:id="@+id/collection_name"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
              android:textColor="@color/on_surface"
              tools:text="The Dark Knight Collection" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <LinearLayout
        android:id="@+id/cast_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingHorizontal="20dp"
          android:text="@string/cast"
          android:textAppearance="@style/TextAppearance.Cinestine.Section" />

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recycler_cast"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:clipToPadding="false"
          android:overScrollMode="never"
          android:paddingStart="16dp"
          android:paddingTop="14dp"
          android:paddingEnd="8dp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/providers_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingHorizontal="20dp">

          <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/where_to_watch"
            android:textAppearance="@style/TextAppearance.Cinestine.Section" />

          <TextView
            android:id="@+id/watch_region"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/colorPrimary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recycler_providers"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:clipToPadding="false"
          android:overScrollMode="never"
          android:paddingStart="20dp"
          android:paddingTop="14dp"
          android:paddingEnd="12dp" />

        <TextView
          android:id="@+id/watch_empty"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingHorizontal="20dp"
          android:paddingTop="14dp"
          android:text="@string/watch_empty"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
          android:textColor="@color/on_surface_variant"
          android:visibility="gone" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/photos_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingHorizontal="20dp"
          android:text="@string/photos"
          android:textAppearance="@style/TextAppearance.Cinestine.Section" />

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recycler_photos"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:clipToPadding="false"
          android:overScrollMode="never"
          android:paddingStart="16dp"
          android:paddingTop="14dp"
          android:paddingEnd="8dp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/similar_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingHorizontal="20dp"
          android:text="@string/more_like_this"
          android:textAppearance="@style/TextAppearance.Cinestine.Section" />

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recycler_similar"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:clipToPadding="false"
          android:overScrollMode="never"
          android:paddingStart="16dp"
          android:paddingTop="14dp"
          android:paddingEnd="8dp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/seasons_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingHorizontal="20dp"
          android:text="@string/seasons"
          android:textAppearance="@style/TextAppearance.Cinestine.Section" />

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recycler_seasons"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:clipToPadding="false"
          android:overScrollMode="never"
          android:paddingStart="16dp"
          android:paddingTop="14dp"
          android:paddingEnd="8dp"
          android:paddingBottom="4dp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/episodes_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/episodes"
          android:textAppearance="@style/TextAppearance.Cinestine.Section" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
          android:id="@+id/episodes_progress"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:layout_marginTop="16dp"
          android:indeterminate="true"
          android:visibility="gone"
          app:indicatorColor="@color/colorPrimary" />

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recycler_episodes"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:nestedScrollingEnabled="false"
          android:overScrollMode="never"
          android:paddingTop="4dp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/trailers_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="28dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingHorizontal="20dp"
          android:text="@string/trailers"
          android:textAppearance="@style/TextAppearance.Cinestine.Section" />

        <com.google.android.material.chip.ChipGroup
          android:id="@+id/video_toggle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingHorizontal="16dp"
          android:paddingTop="10dp"
          app:chipSpacingHorizontal="8dp"
          app:selectionRequired="true"
          app:singleSelection="true">

          <com.google.android.material.chip.Chip
            android:id="@+id/chip_video_all"
            style="@style/Widget.Cinestine.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/video_all" />

          <com.google.android.material.chip.Chip
            android:id="@+id/chip_video_trailers"
            style="@style/Widget.Cinestine.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_trailers" />

          <com.google.android.material.chip.Chip
            android:id="@+id/chip_video_teasers"
            style="@style/Widget.Cinestine.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_teasers" />

          <com.google.android.material.chip.Chip
            android:id="@+id/chip_video_clips"
            style="@style/Widget.Cinestine.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_clips" />
        </com.google.android.material.chip.ChipGroup>

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recycler_trailer"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:clipToPadding="false"
          android:overScrollMode="never"
          android:paddingStart="16dp"
          android:paddingTop="14dp"
          android:paddingEnd="8dp"
          android:paddingBottom="4dp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/reviews_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/reviews"
          android:textAppearance="@style/TextAppearance.Cinestine.Section" />

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recycler_review"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:nestedScrollingEnabled="false"
          android:overScrollMode="never"
          android:paddingTop="8dp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/topics_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/topics"
          android:textAppearance="@style/TextAppearance.Cinestine.Section" />

        <com.google.android.material.chip.ChipGroup
          android:id="@+id/topic_chips"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingTop="10dp"
          app:chipSpacingHorizontal="8dp"
          app:chipSpacingVertical="8dp" />
      </LinearLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/fab"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/fab_margin"
    android:contentDescription="@string/save_movie"
    app:backgroundTint="@color/colorPrimary"
    app:borderWidth="0dp"
    app:elevation="8dp"
    app:layout_anchor="@id/appbar"
    app:layout_anchorGravity="bottom|end"
    app:srcCompat="@drawable/ic_favorite_border"
    app:tint="@color/colorOnPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
