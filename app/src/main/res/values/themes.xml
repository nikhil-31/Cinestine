<resources>
  <style name="Theme.Cinestine" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorOnPrimary">@color/colorOnPrimary</item>
    <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
    <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    <item name="colorAccent">@color/colorAccent</item>
    <item name="colorSecondary">@color/colorSecondary</item>
    <item name="colorOnSecondary">@color/colorOnSecondary</item>
    <item name="colorSurface">@color/surface</item>
    <item name="colorOnSurface">@color/on_surface</item>
    <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
    <item name="colorSurfaceContainer">@color/surface_container</item>
    <item name="colorSurfaceVariant">@color/surface_variant</item>
    <item name="colorOutline">@color/outline</item>
    <item name="android:colorBackground">@color/background</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="android:windowBackground">@color/background</item>
    <item name="toolbarStyle">@style/Widget.Cinestine.Toolbar</item>
    <item name="materialCardViewStyle">@style/Widget.Cinestine.Card</item>
    <item name="floatingActionButtonStyle">@style/Widget.Cinestine.Fab</item>
    <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Cinestine.Small</item>
    <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Cinestine.Medium</item>
    <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Cinestine.Large</item>
  </style>

  <style name="AppTheme" parent="Theme.Cinestine" />

  <style name="AppThemeMain" parent="Theme.Cinestine" />

  <style name="Theme.Cinestine.AppBarOverlay" parent="ThemeOverlay.Material3">
    <item name="android:textColorPrimary">@color/on_surface</item>
    <item name="android:textColorSecondary">@color/on_surface_variant</item>
    <item name="colorControlNormal">@color/on_surface</item>
  </style>

  <style name="Theme.Cinestine.PopupOverlay" parent="ThemeOverlay.Material3" />

  <style name="Widget.Cinestine.Toolbar" parent="Widget.Material3.Toolbar">
    <item name="titleTextAppearance">@style/TextAppearance.Cinestine.Toolbar</item>
    <item name="titleTextColor">@color/on_surface</item>
    <item name="android:background">@color/surface</item>
  </style>

  <style name="TextAppearance.Cinestine.Toolbar" parent="TextAppearance.Material3.TitleLarge">
    <item name="android:textColor">@color/colorPrimary</item>
    <item name="android:letterSpacing">0.02</item>
    <item name="android:textStyle">bold</item>
    <item name="fontFamily">sans-serif</item>
  </style>

  <style name="TextAppearance.Cinestine.Section" parent="TextAppearance.Material3.TitleMedium">
    <item name="android:textColor">@color/on_surface</item>
    <item name="android:letterSpacing">0.08</item>
    <item name="fontFamily">sans-serif-medium</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:textSize">12sp</item>
  </style>

  <style name="TextAppearance.Cinestine.HeroTitle" parent="TextAppearance.Material3.HeadlineMedium">
    <item name="android:textColor">@color/white</item>
    <item name="android:letterSpacing">-0.01</item>
    <item name="fontFamily">sans-serif-medium</item>
    <item name="android:textSize">34sp</item>
    <item name="android:shadowColor">#80000000</item>
    <item name="android:shadowDx">0</item>
    <item name="android:shadowDy">2</item>
    <item name="android:shadowRadius">8</item>
  </style>

  <style name="TextAppearance.Cinestine.DetailsTitle" parent="TextAppearance.Material3.HeadlineMedium">
    <item name="android:textColor">@color/on_surface</item>
    <item name="android:letterSpacing">-0.01</item>
    <item name="fontFamily">sans-serif-medium</item>
    <item name="android:textSize">28sp</item>
  </style>

  <style name="TextAppearance.Cinestine.Score" parent="TextAppearance.Material3.HeadlineSmall">
    <item name="android:textColor">@color/on_surface</item>
    <item name="fontFamily">sans-serif-medium</item>
    <item name="android:letterSpacing">-0.02</item>
  </style>

  <style name="Widget.Cinestine.Card" parent="Widget.Material3.CardView.Elevated">
    <item name="cardBackgroundColor">@color/surface_container</item>
    <item name="cardElevation">0dp</item>
    <item name="strokeWidth">0dp</item>
    <item name="shapeAppearance">@style/ShapeAppearance.Cinestine.Medium</item>
  </style>

  <style name="Widget.Cinestine.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
    <item name="backgroundTint">@color/colorPrimary</item>
    <item name="tint">@color/colorOnPrimary</item>
  </style>

  <style name="ShapeAppearance.Cinestine.Small" parent="ShapeAppearance.Material3.SmallComponent">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">10dp</item>
  </style>

  <style name="ShapeAppearance.Cinestine.Medium" parent="ShapeAppearance.Material3.MediumComponent">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">16dp</item>
  </style>

  <style name="ShapeAppearance.Cinestine.Large" parent="ShapeAppearance.Material3.LargeComponent">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">24dp</item>
  </style>

  <style name="Widget.Cinestine.Chip.Filter" parent="Widget.Material3.Chip.Filter">
    <item name="checkedIconVisible">false</item>
    <item name="chipCornerRadius">100dp</item>
    <item name="chipMinHeight">36dp</item>
    <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
  </style>
</resources>
